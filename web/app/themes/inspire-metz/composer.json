{
    "name": "pixim/inspire-metz-theme",
    "type": "wordpress-theme",
    "license": "MIT",
    "description": "Thème Inspire Metz (Sage 11)",
    "keywords": [
        "wordpress"
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "laravel/pint": "^1.20"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
